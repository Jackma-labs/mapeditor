# Runtime mode.
MAP_RUNTIME_MODE=local
MAP_SKIP_VALIDATION=false

# Native tool paths. Keep defaults unless binaries are installed elsewhere.
# MAP_CONVERTER_BINARY=/home/dell/mapeditor/runtime/bin/editor_map_converter
# MAP_TILE_MAP_CREATOR_BINARY=/home/dell/mapeditor/runtime/bin/tile_map_images_creator

# Edge deployment. Enable after passwordless SSH from this server to the edge
# device is configured.
MAP_EDGE_DEPLOY_MODE=disabled
MAP_EDGE_HOST=
MAP_EDGE_USER=
MAP_EDGE_PORT=22
MAP_EDGE_TARGET_MAP_ROOT=/apollo/modules/map/data
MAP_EDGE_POST_DEPLOY_COMMAND=

# Runtime mode.
MAP_RUNTIME_MODE=local
MAP_SKIP_VALIDATION=false

# Native tool paths. Keep defaults unless binaries are installed elsewhere.
# MAP_CONVERTER_BINARY=/home/dell/mapeditor/runtime/bin/editor_map_converter
# MAP_TILE_MAP_CREATOR_BINARY=/home/dell/mapeditor/runtime/bin/tile_map_images_creator

# Edge deployment. Enable after passwordless SSH from this server to the edge
# device is configured.
MAP_EDGE_DEPLOY_MODE=disabled
MAP_EDGE_HOST=
MAP_EDGE_USER=
MAP_EDGE_PORT=22
MAP_EDGE_TARGET_MAP_ROOT=/apollo/modules/map/data
MAP_EDGE_POST_DEPLOY_COMMAND=
MAP_EDGE_COORDINATE_MAX_DISTANCE_METERS=1000
MAP_EDGE_VEHICLE_LANE_WARNING_METERS=0.5
MAP_EDGE_VEHICLE_LANE_ERROR_METERS=1.5
MAP_EDGE_REQUIRE_LOCALIZATION_GATE=true
MAP_EDGE_REQUIRE_RTK_FIX=true
MAP_EDGE_LOCALIZATION_WARNING_DELAY_SECONDS=0.5
MAP_EDGE_LOCALIZATION_ERROR_DELAY_SECONDS=2
MAP_EDGE_HEADING_WARNING_RADIANS=0.05
MAP_EDGE_HEADING_ERROR_RADIANS=0.15
MAP_EDGE_MAP_BOUNDARY_MARGIN_METERS=5
MAP_EDGE_REMOTE_BOUNDS_TOLERANCE_METERS=0.5
